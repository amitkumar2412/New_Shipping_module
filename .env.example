# Settings for local runs. On the server the deploy workflow writes
# /etc/shipping-module/shipping.env from GitHub secrets instead.
# Keep comments on their own lines, and use a DB password without spaces, quotes, backslashes or '#'.

# ---- database (the chem-os database on RDS) ----
# Hostname only, no /dbname suffix.
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=chemos_dev
# A dedicated least-privilege user; see sql/grants.sql.
DB_USER=shipping_scraper
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10

# ---- scheduled run ----
# Track chem-os my-ships (MY_SHIPS_TABLE) and every ship in mainshipdata.
SYNC_MY_SHIPS=true
MY_SHIPS_TABLE=shipwithid
# Skip ships scraped successfully this recently (avoids double scrapes after a manual or catch-up run).
SKIP_RECENT_HOURS=2
# A run stops itself after this long, so it never overlaps the next one.
MAX_RUN_MINUTES=240
# Stop the run when this many ships in a row are blocked by MarineTraffic.
MAX_CONSECUTIVE_BLOCKS=3

# ---- scraper ----
# Optional outbound proxy, e.g. http://user:pass@proxy:8080
SCRAPER_PROXY=
SCRAPER_TIMEOUT=30

# ---- logging ----
LOG_LEVEL=INFO
LOG_FORMAT=text
