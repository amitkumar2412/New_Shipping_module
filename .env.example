# Copy to .env and fill in. Never commit real values.
# Keep comments on their own lines: docker compose and python-dotenv treat inline comments differently.

# ---- database (the same Postgres database chem-os uses) ----
# Hostname only, no /dbname suffix.
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=chemos_dev
# A dedicated least-privilege user; see sql/grants.sql.
DB_USER=shipping_scraper
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10

# ---- worker ----
# Refresh intervals. Each ship has its own timer, so scrapes spread over the day.
# Ships chem-os marks as my_ship (from purchases): every 6 hours.
MY_SHIP_INTERVAL_MINUTES=360
# Every other ship in mainshipdata: every 24 hours.
OTHER_SHIP_INTERVAL_MINUTES=1440
# A ship last seen moored / at anchor / not moving waits at least 10 hours.
STATIONARY_INTERVAL_MINUTES=600
# Hard ceiling on ships scraped per hour (each ship is ~5 requests to MarineTraffic).
MAX_SHIPS_PER_HOUR=60
# How often to look for new my-ships and requested scrapes.
POLL_SECONDS=60
# Track chem-os my-ships (MY_SHIPS_TABLE) and every ship in mainshipdata.
SYNC_MY_SHIPS=true
MY_SHIPS_TABLE=shipwithid
# Back off when this many ships in a row are blocked by MarineTraffic.
MAX_CONSECUTIVE_BLOCKS=3

# ---- scraper ----
# Optional outbound proxy, e.g. http://user:pass@proxy:8080
SCRAPER_PROXY=
SCRAPER_TIMEOUT=30

# ---- api ----
# Required for POST /ships/{id}/scrape. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
API_PORT=8000

# ---- logging ----
LOG_LEVEL=INFO
# json in production, text locally.
LOG_FORMAT=json
